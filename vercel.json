{
  "version": 2,
  "functions": {
    "api/shinjuku-page.js": { "includeFiles": "shinjuku_crawler.html" }
  },
  "redirects": [
    { "source": "/shinjuku_crawler.html", "destination": "/shinjuku", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/shinjuku",
      "destination": "/api/shinjuku-page"
    },
    {
      "source": "/koma-maker",
      "destination": "/koma-maker.html"
    }
  ]
}
